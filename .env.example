# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth (this is the Convex HTTP Actions domain, not Vite's URL).
# Local value is normally written to .env.local by `npx convex dev`.
CONVEX_SITE_URL=

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Email OTP delivery (Convex backend variables; never prefix with VITE_).
# Set AUTH_RESEND_KEY with `npx convex env set` on each target deployment.
# AUTH_RESEND_KEY=re_your_resend_api_key

# Required sender identity; configure/verify the sending domain in Resend first.
# AUTH_EMAIL_FROM=Focus Rewards <auth@your-verified-domain.example>
