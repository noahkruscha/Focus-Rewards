{
  "manifest_version": 3,
  "name": "Focus Rewards — YouTube Estimates",
  "version": "1.0.0",
  "description": "See an estimated Focus Rewards coin value on regular YouTube video recommendations.",
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["options/options.html"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "host_permissions": ["https://www.youtube.com/*", "https://*.convex.site/*"],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/pricing.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
